@charset "utf-8";

:root { --stone-dark: #1c1b19; --stone-mid: #2b2926; --stone-line: #3d3a35; --parchment: #e9e2d3; --parchment-dim: #a9a196; --bronze: #b0854f; --bronze-bright: #d4a765; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; color: var(--parchment); font-family: Inter, sans-serif; min-height: 100vh; background-image: radial-gradient(circle at 20% 10%, rgba(176, 133, 79, 0.06), transparent 40%), radial-gradient(circle at 80% 90%, rgba(176, 133, 79, 0.05), transparent 40%); }

.wrap { max-width: 720px; margin: 0px auto; padding: 0px 20px 100px; }

header.hero { padding: 56px 20px 40px; text-align: center; border-bottom: 1px solid var(--stone-line); background-image: linear-gradient(rgba(20, 19, 17, 0.55), rgba(20, 19, 17, 0.75)), url("bg-hero.jpg"); background-size: cover; background-position: center center; }

.mark { display: flex; flex-direction: column; align-items: center; gap: 10px; font-family: "Cormorant Garamond", serif; font-size: 13px; letter-spacing: 6px; text-transform: uppercase; color: var(--bronze-bright); margin-bottom: 18px; }

.logo-svg { width: 46px; height: 46px; }

.quote-block { font-family: "Cormorant Garamond", serif; font-style: italic; font-size: clamp(22px, 5vw, 30px); line-height: 1.4; color: var(--parchment); min-height: 100px; display: flex; align-items: center; justify-content: center; transition: opacity 0.5s; padding: 0px 10px; }

.quote-author { margin-top: 14px; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: var(--parchment-dim); }

.chisel-line { width: 60px; height: 1px; background: var(--bronze); margin: 24px auto 0px; }

nav { display: flex; justify-content: center; gap: 4px; flex-wrap: wrap; margin: 32px auto 0px; max-width: 720px; }

nav button { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--parchment-dim); font-family: Inter, sans-serif; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; font-weight: 600; padding: 10px 16px; cursor: pointer; position: relative; transition: color 0.25s; }

nav button.active { color: var(--bronze-bright); }

nav button.active::after { content: ""; position: absolute; left: 16px; right: 16px; bottom: 0px; height: 2px; background: var(--bronze-bright); }

section.panel { display: none; padding-top: 36px; }

section.panel.active { display: block; animation: 0.4s ease 0s 1 normal none running fade; }

@keyframes fade { 
  0% { opacity: 0; transform: translateY(6px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.section-title { font-family: "Cormorant Garamond", serif; font-size: 22px; font-style: italic; color: var(--bronze-bright); margin-bottom: 18px; }

.search-bar { display: flex; align-items: center; gap: 10px; background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 6px; padding: 10px 14px; margin-bottom: 20px; }

.search-bar input { flex: 1 1 0%; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; color: var(--parchment); font-family: Inter, sans-serif; font-size: 14px; }

.search-bar input::placeholder { color: var(--parchment-dim); }

.search-icon { color: var(--bronze); font-size: 14px; }

.no-results { color: var(--parchment-dim); font-size: 13px; text-align: center; padding: 20px 0px; font-style: italic; }

.track { padding: 14px 16px; background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 6px; margin-bottom: 10px; }

.track-top-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; }

.track-controls-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

.track-num { font-family: "Cormorant Garamond", serif; color: var(--bronze); font-size: 18px; width: 24px; flex-shrink: 0; }

.track-info { flex: 1 1 0%; min-width: 0px; }

.track-title { font-size: 14px; font-weight: 600; }

.track-sub { font-size: 12px; color: var(--parchment-dim); margin-top: 2px; }

.dl-btn { background: transparent; border: 1px solid var(--bronze); color: var(--bronze-bright); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; padding: 8px 14px; border-radius: 4px; cursor: pointer; transition: 0.2s; font-weight: 600; white-space: nowrap; flex-shrink: 0; }

.dl-btn:hover { background: var(--bronze); color: var(--stone-dark); }

.price-badge { font-size: 10px; font-weight: 700; letter-spacing: 0.5px; padding: 3px 8px; border-radius: 3px; white-space: nowrap; text-transform: uppercase; flex-shrink: 0; }

.price-badge.free { background: rgba(122, 168, 116, 0.15); color: rgb(143, 201, 138); border: 1px solid rgba(143, 201, 138, 0.4); }

.price-badge.paid { background: rgba(176, 133, 79, 0.15); color: var(--bronze-bright); border: 1px solid var(--bronze); }

.dl-btn.paid-btn { background: var(--bronze); color: var(--stone-dark); }

.dl-btn.paid-btn:hover { background: var(--bronze-bright); }

.preview-btn { background: transparent; border: 1px solid var(--bronze-bright); color: var(--bronze-bright); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-weight: 600; white-space: nowrap; flex-shrink: 0; }

.preview-btn.playing { background: var(--bronze-bright); color: var(--stone-dark); }

.mini-player { display: none; position: sticky; bottom: 0px; left: 0px; right: 0px; background: var(--stone-mid); border-top: 1px solid var(--bronze); padding: 12px 16px; z-index: 40; margin: 16px -20px -20px; }

.mini-player.show { display: block; }

.mini-player-title { font-family: "Cormorant Garamond", serif; font-style: italic; color: var(--bronze-bright); font-size: 15px; text-align: center; margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.mini-player-controls { display: flex; align-items: center; justify-content: center; gap: 18px; }

.mini-player-controls button { background: transparent; border: 1px solid var(--stone-line); color: var(--parchment); width: 42px; height: 42px; border-radius: 50%; font-size: 16px; cursor: pointer; }

.mini-player-controls button.play-pause { width: 52px; height: 52px; background: var(--bronze); color: var(--stone-dark); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; font-size: 18px; }

.lightbox-overlay { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.9); z-index: 200; align-items: center; justify-content: center; padding: 20px; }

.lightbox-overlay.open { display: flex; }

.lightbox-overlay img, .lightbox-overlay video { max-width: 100%; max-height: 85vh; border-radius: 6px; }

.lightbox-close { position: absolute; top: 20px; right: 20px; background: var(--stone-mid); border: 1px solid var(--stone-line); color: var(--parchment); font-size: 20px; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; }

.lyrics-btn { background: transparent; border: 1px solid var(--stone-line); color: var(--parchment-dim); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; padding: 8px 12px; border-radius: 4px; cursor: pointer; transition: 0.2s; font-weight: 600; white-space: nowrap; flex-shrink: 0; }

.lyrics-btn:hover { border-color: var(--bronze); color: var(--bronze-bright); }

.lyrics-panel { display: none; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--stone-line); }

.lyrics-panel.open { display: block; }

.lyrics-panel textarea { width: 100%; min-height: 140px; background: var(--stone-dark); border: 1px solid var(--stone-line); border-radius: 4px; color: var(--parchment); font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 15px; line-height: 1.6; padding: 12px; resize: vertical; }

.lyrics-panel textarea::placeholder { color: var(--parchment-dim); font-style: italic; }

.lyrics-save { margin-top: 8px; background: transparent; border: 1px solid var(--bronze); color: var(--bronze-bright); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; padding: 6px 12px; border-radius: 4px; cursor: pointer; float: right; }

.gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.gallery img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 6px; border: 1px solid var(--stone-line); filter: grayscale(15%) contrast(1.05); transition: transform 0.3s; }

.gallery a:hover img { transform: scale(1.02); filter: grayscale(0%); }

.gallery a { position: relative; display: block; }

.gallery .price-badge { position: absolute; top: 8px; left: 8px; }

.gallery-dl { position: absolute; bottom: 8px; right: 8px; background: rgba(28, 27, 25, 0.75); border: 1px solid var(--bronze); color: var(--bronze-bright); font-size: 11px; padding: 5px 9px; border-radius: 4px; text-decoration: none; letter-spacing: 0.5px; }

.gallery-dl.paid { background: var(--bronze); color: var(--stone-dark); border-color: var(--bronze); }

.wisdom-card { background: var(--stone-mid); border-left: 3px solid var(--bronze); padding: 18px 20px; margin-bottom: 14px; border-radius: 4px; }

.wisdom-text { font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 17px; line-height: 1.5; color: var(--parchment); }

.wisdom-author { margin-top: 10px; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--bronze); }

.about-hero { text-align: center; margin-bottom: 28px; }

.about-photo { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; border: 2px solid var(--bronze); margin-bottom: 14px; }

.about-name { font-family: "Cormorant Garamond", serif; font-size: 24px; font-style: italic; color: var(--parchment); }

.about-role { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--bronze); margin-top: 4px; }

.about-bio { font-size: 14px; line-height: 1.7; color: var(--parchment-dim); margin: 18px 0px; text-align: center; }

.about-contact { display: flex; flex-direction: column; gap: 12px; background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 8px; padding: 18px; }

.about-contact a { color: var(--parchment); text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 10px; }

.about-contact a:hover { color: var(--bronze-bright); }

.about-contact .tag { color: var(--bronze); font-size: 12px; width: 70px; text-transform: uppercase; letter-spacing: 1px; flex-shrink: 0; }

.share-fab { position: fixed; bottom: 22px; right: 22px; background: var(--bronze); color: var(--stone-dark); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 50px; padding: 12px 20px; font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 16px; z-index: 50; }

.admin-fab { position: fixed; bottom: 22px; left: 22px; background: var(--stone-mid); color: var(--parchment-dim); border: 1px solid var(--stone-line); border-radius: 50px; padding: 12px 16px; font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; z-index: 50; }

.admin-fab.active { background: var(--bronze); color: var(--stone-dark); border-color: var(--bronze); }

.admin-banner { display: none; background: rgba(176, 133, 79, 0.12); border: 1px solid var(--bronze); border-radius: 6px; padding: 10px 14px; margin-bottom: 16px; font-size: 12px; color: var(--bronze-bright); text-align: center; }

.admin-banner.show { display: block; }

.add-btn { display: block; width: 100%; background: transparent; border: 1px dashed var(--bronze); color: var(--bronze-bright); font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 14px; border-radius: 6px; margin-bottom: 16px; cursor: pointer; }

.add-btn:hover { background: rgba(176, 133, 79, 0.1); }

.add-form { display: none; background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 8px; padding: 16px; margin-bottom: 18px; }

.add-form.open { display: block; }

.add-form input, .add-form textarea { width: 100%; background: var(--stone-dark); border: 1px solid var(--stone-line); color: var(--parchment); padding: 9px 10px; border-radius: 4px; font-family: Inter, sans-serif; font-size: 13px; margin-bottom: 10px; }

.add-form textarea { font-family: "Cormorant Garamond", serif; font-style: italic; min-height: 80px; }

.add-form input[type="file"] { padding: 8px; font-size: 12px; }

.upload-progress { display: none; height: 6px; background: var(--stone-dark); border-radius: 3px; overflow: hidden; margin-bottom: 10px; }

.upload-progress.show { display: block; }

.upload-progress-bar { height: 100%; background: var(--bronze-bright); width: 0%; transition: width 0.2s; }

.upload-status { font-size: 11px; color: var(--parchment-dim); margin-bottom: 8px; }

.add-form-actions { display: flex; gap: 8px; justify-content: flex-end; }

.add-form-actions button { padding: 8px 16px; border-radius: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }

.add-save { background: var(--bronze); color: var(--stone-dark); }

.add-cancel { background: transparent; color: var(--parchment-dim); border: 1px solid var(--stone-line) !important; }

.item-remove { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: rgb(201, 106, 90); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer; margin-left: 8px; }

.modal-overlay { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.6); z-index: 100; align-items: center; justify-content: center; }

.modal-overlay.open { display: flex; }

.modal-box { background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 10px; padding: 28px; max-width: 320px; width: 90%; text-align: center; position: relative; }

.modal-close { position: absolute; top: 10px; right: 14px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--parchment-dim); font-size: 18px; cursor: pointer; }

.modal-box h3 { font-family: "Cormorant Garamond", serif; font-style: italic; color: var(--bronze-bright); font-size: 20px; margin-bottom: 16px; }

#qrcode-canvas { display: flex; justify-content: center; margin: 12px 0px; background: rgb(255, 255, 255); padding: 10px; border-radius: 6px; }

.payment-info-box { background: var(--stone-dark); border: 1px solid var(--bronze); border-radius: 6px; padding: 14px; margin: 6px 0px; text-align: left; }

.payment-info-box .pay-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--bronze-bright); }

.payment-info-box .pay-number { font-size: 18px; font-weight: 700; color: var(--parchment); margin: 4px 0px; }

.payment-note { font-size: 12px; color: var(--parchment-dim); margin-top: 12px; line-height: 1.5; }

.share-link-box { display: flex; gap: 6px; margin-top: 14px; }

.share-link-box input { flex: 1 1 0%; background: var(--stone-dark); border: 1px solid var(--stone-line); color: var(--parchment-dim); font-size: 12px; padding: 8px; border-radius: 4px; }

.share-link-box button { background: var(--bronze); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--stone-dark); padding: 8px 12px; border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer; }

footer { text-align: center; padding: 40px 20px 90px; font-size: 11px; color: var(--parchment-dim); letter-spacing: 1px; }

.register-banner { background: var(--stone-mid); border: 1px solid var(--bronze); border-radius: 8px; padding: 18px; margin: 20px 20px 0px; }

.register-banner h3 { font-family: "Cormorant Garamond", serif; font-style: italic; color: var(--bronze-bright); font-size: 19px; margin-bottom: 8px; }

.register-banner p { font-size: 13px; color: var(--parchment-dim); margin-bottom: 12px; line-height: 1.5; }

.register-form { display: flex; flex-direction: column; gap: 8px; }

.register-form input { background: var(--stone-dark); border: 1px solid var(--stone-line); color: var(--parchment); padding: 10px; border-radius: 4px; font-family: Inter, sans-serif; font-size: 13px; }

.register-form button { background: var(--bronze); color: var(--stone-dark); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 11px; border-radius: 4px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; font-size: 13px; cursor: pointer; }

.register-done { display: none; color: var(--bronze-bright); font-size: 14px; font-style: italic; text-align: center; }

.register-done.show { display: block; }

.register-form.hide { display: none; }

.stats-locked { text-align: center; color: var(--parchment-dim); font-size: 14px; padding: 40px 20px; font-style: italic; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }

.stat-card { background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 8px; padding: 18px; text-align: center; }

.stat-number { font-family: "Cormorant Garamond", serif; font-size: 32px; color: var(--bronze-bright); }

.stat-label { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--parchment-dim); margin-top: 4px; }

.subscriber-row { background: var(--stone-mid); border: 1px solid var(--stone-line); border-radius: 6px; padding: 12px 14px; margin-bottom: 8px; font-size: 13px; }

.subscriber-row .sub-name { font-weight: 600; color: var(--parchment); }

.subscriber-row .sub-email { color: var(--parchment-dim); font-size: 12px; }
